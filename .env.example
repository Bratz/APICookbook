# Copy to .env for local development (never commit the real one).
# On the OCI VM the same settings live in deploy/oci/docker-compose.yml instead.
DEBUG=False
ENVIRONMENT=development
API_PORT=7600
API_BASE_URL=https://demoapps.tcsbancs.com
API_TIMEOUT=30
BANCS_ENTITY=GPRDTTSTOU
BANCS_USER_ID=1
BANCS_LANGUAGE_CODE=1
MCP_ENABLED=True
FEATURE_CHAT_ENABLED=True
FEATURE_COOKBOOK_ENABLED=True
FEATURE_PLAYGROUND_ENABLED=True

# Semantic search: real bge-small embeddings (RAG) first, keyword search as the fallback.
# DISABLE_BERT_SEARCH keeps the older TF-IDF "BERT" search out of the search path (it ranks worse).
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DISABLE_BERT_SEARCH=true
ENABLE_BERT=true

# Code-writing agent (docs/coding-agent-plan.md). Put your real key in .env, never here.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_RATE_PER_HOUR=10
AGENT_DAILY_CAP_USD=5
AGENT_MONTHLY_CAP_USD=50
AGENT_DATA_DIR=data/agent
